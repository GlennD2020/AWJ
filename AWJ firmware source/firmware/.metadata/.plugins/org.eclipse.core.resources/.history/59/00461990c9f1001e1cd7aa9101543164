/****************************************************************************
 *						PROJECT DEFINES										*
 ****************************************************************************/
#define _DMS_

#define HARDWARE_VERSION 			4

#define FIRMWARE_VERSION_MAJOR		3
#define FIRMWARE_VERSION_MINOR		2

